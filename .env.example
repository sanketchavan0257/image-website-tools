# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RAZORPAY_KEY_ID: Razorpay Key ID for membership payments (e.g. rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID="rzp_test_1DP5mmOlF5G5ag"

# RAZORPAY_KEY_SECRET: Server-only Razorpay Key Secret for AutoPay subscriptions (/api/subscription/*) & pro-rata refunds (/api/refund)
# Configure this in AI Studio Secrets or Render Environment Variables (never expose on the frontend)
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: Webhook secret configured in Razorpay Dashboard -> Webhooks (for /api/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=""

# ADMIN_EMAIL / VITE_ADMIN_EMAIL: Authorized administrator email for accessing /admin panel
# Set this in .env or Render Environment Variables
ADMIN_EMAIL=""

# SUPPORT_EMAIL / VITE_SUPPORT_EMAIL: Support inbox that receives Help page contact emails and complaints
# Falls back to ADMIN_EMAIL if omitted
SUPPORT_EMAIL=""

# SUPPORT_PHONE / VITE_SUPPORT_PHONE: Support mobile number shown on the Help page
SUPPORT_PHONE="+91 98765 43210"

# ==============================================================================
# EMAIL OTP & COMPLAINT DELIVERY (Configure ANY ONE provider below)
# ==============================================================================
# Option A: Gmail / Custom SMTP (Recommended if Brevo API blocks Render IPs)
# Generate a 16-character Gmail App Password from Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Option B: Brevo Transactional Email API
BREVO_API_KEY=""
SENDER_EMAIL=""

# Option C: Resend API
RESEND_API_KEY=""

# OTP_SECRET: Optional server-side secret for signing OTP challenges
OTP_SECRET=""

# FIREBASE_SERVICE_ACCOUNT: Full Firebase service-account JSON on ONE line (Firebase Console -> Project settings -> Service accounts -> Generate new private key).
# Lets the Razorpay webhook activate memberships in Firestore the moment payment succeeds.
FIREBASE_SERVICE_ACCOUNT=""
